{
  "name": "sculpy-desktop-companion",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc --noEmit && vite build",
    "test": "node --import tsx --test tests/*.test.ts",
    "model": "node scripts/build-model.mjs",
    "tauri": "tauri",
    "check": "npm test && npm run build",
    "test:ui": "node scripts/smoke-ui.mjs",
    "format": "prettier --write src tests scripts *.json docs README.md",
    "test:production": "node scripts/smoke-production.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.9.0",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.0",
    "@types/node": "^24.0.0",
    "@types/three": "^0.183.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.0"
  }
}
